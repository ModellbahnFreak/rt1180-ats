mainmenu "Asynchronous Traffic Shaping IEEE 802.1Qcr"

config ATS_NUM_INTERFACES
	int "Number of interfaces/traffic classes with ATS support"
	default 0
	range 0 255
	help
	  Default: 0 = as many as are defined in the device tree. 
	  The maximum number of interface + traffic/pcp class cominations for which ATS support can be enabled.
	  The ATS on the same interface but different traffic class is treated like an independant interface!

config ATS_SCHEDULER_INSTANCES
	int "Number of ATS instances (maximum number of apps/streams)"
    default 5
	range 1 255
	help
	  The maximum number of ATS instances to allocate space for per iface/traffic class.
	  Defines the maximum number of apps thet can be used

config ATS_GROUP_INSTANCES
	int "Number of ATS groups"
    default 5
	range 1 255
	help
	  The maximum number of ATS groups to allocate space for per iface/traffic class.
	  Every scheduler used must be assigned to a group (multiple can be assigned to same group)

config ATS_QUEUE_LENGTH
    int "Size of queue for every ATS group"
    default 5
	range 1 255
	help
	  The size of the queue/ring buffer for every ATS scheduler group.
	  If the queue is full and more packets arrive for the 

config ATS_LOG_LEVEL
	int "Log level to use in ATS code (none: 0 to debug: 4)"
	default 4

config ATS_ASSERT_ON_SEND
	bool "Perform assertion checks on ATS send"
	default n
	help
	  Defines wether the ATS send path should perform assertions to check validity of parameters etc.
	  This causes some performace hit, it is useful for debugging but should be disabled in production

config ATS_TIMER_EPSILON_NS
	int "Number of nanoseconds of allowable jitter for timer updating"
	default 1000
	help
	  The number of nanoseconds to use as tolerance when setting a new timer expiry.
	  In the case a new packet with elegibility time within this epsilon arrives, it will ony be sent up to this amount of time later.
	  Required to avoid race condition when setting timer.
	  MUST be bigger than the time required for thread-lock, isr-lock, timer alarm update and both unlocks

config ATS_IFACE_INIT_PRIO
	int "Init priority for ats ifeces (between ETH_INIT_PRIORITY and NET_INIT_PRIO)"
	depends on NET_INIT_PRIO > ETH_INIT_PRIORITY
	default 61
	range ETH_INIT_PRIORITY NET_INIT_PRIO
	help
	  The initialization priority for ats interfaces. MUST be BIGGER than ETH_INIT_PRIORITY and SMALLER than NET_INIT_PRIO.
	  If set incorrectly, the initialization of the ats interface will fail (as ethernet and interface init are called in wrong order or parent devices aren't ready yet)

config ATS_VERIFY_ENABLED
	bool "Enable ats correctness verification"
	default n
	help
	  Enable this to check and log correctness of ATS packet sending.
	  This will start another (low prio) thread that does the verification by tracking the bucket states separately

config ATS_VERIFY_NO_PROCESSING
	bool "Disable processing threads of ats verify, only collect timestamps"
	default n
	help
	  To prevent the processing threads of ats verify to be spawned, set this to y, then only the timestamps will be collected.
	  Can be dumped using debugger

config ATS_VERIFY_LOG_LEVEL
	int "Log level for ATS verification"
	default 3
	help
	  The verbosity of the ATS verification.
	  0: none, 1: only errors in verifyer code, 2: warn if ATS did not comply to specification, 3: regular info of bucket states, 4: debug info from verifyer

source "Kconfig.zephyr"