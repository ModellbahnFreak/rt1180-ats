/ {
	aliases {
		lan = &enetc_psi1;
		eth0 = &switch_port0;
		eth1 = &switch_port1;
		eth2 = &switch_port2;
		eth3 = &switch_port3;
		eth4 = &enetc_psi0;
	};

	soc {
		peripheral: peripheral@40000000 {
			netc: ethernet {
				enetc_psi0: ethernet@60b00000 {
					status = "okay";
				};
			};
		};
	};
};

&switch {
	status = "okay";
	switch_port@0 {
		status = "okay";
	};
	switch_port@0 {
		status = "okay";
	};
	switch_port@0 {
		status = "okay";
	};
	switch_port@0 {
		status = "okay";
	};
};
