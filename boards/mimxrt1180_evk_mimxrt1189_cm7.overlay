/ {
	aliases {
		lan = &enetc_psi0;
		eth0 = &switch_port0;
		eth1 = &switch_port1;
		eth2 = &switch_port2;
		eth3 = &switch_port3;
		eth4 = &enetc_psi0;
		ethpseudo = &enetc_psi1;
		//time = &netc_ptp_clock0;
		time = &gpt1;
	};

	soc {
		peripheral: peripheral@40000000 {
			netc: ethernet {
				enetc_psi0: ethernet@60b00000 {
					status = "okay";
				};
			};
		};
	};
};

&switch {
	status = "okay";
	switch_port@0 {
		status = "okay";
	};
	switch_port@0 {
		status = "okay";
	};
	switch_port@0 {
		status = "okay";
	};
	switch_port@0 {
		status = "okay";
	};
};

&gpt1 {
	status = "okay";
	gptfreq = <DT_FREQ_M(240)>;
	run-mode = "free-run";
};

&netc_ptp_clock0 {
	status = "okay";
};